@tool
extends Node3D
## Island grass scatterer (Part 9 of the island guide).
## Raycasts down at random points around itself and, wherever it hits
## flat-enough ground, places one grass blade into a single
## MultiMeshInstance3D (one draw call for every blade — mobile friendly).
##
## The blade mesh must carry the black->white vertex paint (COLOR_0) from
## Part 5.2; grass_wind.gdshader reads it as the bend mask, and each blade's
## INSTANCE_CUSTOM (phase, random strength) makes every blade sway out of sync.
##
## IMPORTANT: ray hits are in WORLD space, but the MultiMeshInstance3D lives
## under this node (which is itself a child of the Island). MultiMesh
## transforms are relative to the MultiMeshInstance, so every hit transform is
## converted into THIS node's local space before it is stored — otherwise the
## island offset is applied twice and the whole field lands over open ocean,
## where it can never be seen.
##
## Set max_height_above_water to 90.0 or more to disable the sea-level filter.

const WORLD_MASK := 1
const VEGETATION_VISUAL := preload("res://scripts/vegetation_visual.gd")
const DEFAULT_GRASS: PackedScene = preload("res://models/realistic_grass.glb")
static var _prepared_meshes: Dictionary = {}
## Runtime retry budget: the island collider is generated by island_setup.gd
## AFTER this node's _ready (tree order), so the first pass finds no ground.
## Cooking the dense beach-scan trimesh plus the per-palm bodies takes a while,
## so allow a generous number of frames before giving up.
const RETRY_FRAMES := 120

@export_file("*.glb", "*.gltf", "*.scn", "*.tscn") var sketchfab_grass_model := "res://models/realistic_grass.glb": set = set_sketchfab_grass_model
@export_file("*.glb", "*.gltf", "*.obj") var grass_mesh_path := "res://models/grass_blade.glb": set = set_grass_mesh_path
@export_file("*.gdshader") var shader_path := "res://shaders/grass_wind.gdshader": set = set_shader_path
@export var instance_count := 3000: set = set_instance_count
@export var natural_tufts := true
@export var target_tuft_height := 0.38 ## normalizes imported grass meshes to island scale (m)
@export var scatter_radius := 10.0: set = set_scatter_radius
@export var scatter_seed := 12345: set = set_seed
@export var raycast_up := 8.0 ## how far above the node to start searching
@export var raycast_down := 12.0 ## how far below the node to search
@export var min_surface_flatness := 0.7 ## 1.0 = perfectly flat, ~0.7 = gentle slopes ok
@export var align_to_normal := true
@export var max_height_above_water := 3.0 ## skip points this far above sea level (mound top)
@export var min_height_above_water := -0.15 ## skip points this far BELOW sea level (submerged sand)

var _rng := RandomNumberGenerator.new()
var _retries_left := RETRY_FRAMES
var _build_generation := 0
var _imported_albedo_texture: Texture2D = null
var _using_imported_model := false
var _prepare_phase := "idle"
var _prepare_progress := Vector2i.ZERO

# Hundreds of Mesh-vs-ray queries in one frame can stall phones while the
# island's dense trimesh is being scattered. Time-slice the work instead.
const RUNTIME_RAY_BATCH_SIZE := 64
const FRAME_WORK_BUDGET := preload("res://scripts/frame_work_budget.gd")

func _ready() -> void:
	if not Engine.is_editor_hint():
		rebuild()

# ---- editor live-rebuild on any tweak ----
func set_sketchfab_grass_model(v: String) -> void:
	sketchfab_grass_model = v
	_rebuild_if_ready()

func set_grass_mesh_path(v: String) -> void:
	grass_mesh_path = v
	_rebuild_if_ready()

func set_shader_path(v: String) -> void:
	shader_path = v
	_rebuild_if_ready()

func set_instance_count(v: int) -> void:
	instance_count = v
	_rebuild_if_ready()

func set_scatter_radius(v: float) -> void:
	scatter_radius = v
	_rebuild_if_ready()

func set_seed(v: int) -> void:
	scatter_seed = v
	_rebuild_if_ready()

func _rebuild_if_ready() -> void:
	if is_inside_tree():
		rebuild()

func _notification(what: int) -> void:
	if what == NOTIFICATION_TRANSFORM_CHANGED and Engine.is_editor_hint():
		rebuild()

func rebuild() -> void:
	_build_generation += 1
	var generation := _build_generation
	# Drop the previous field and cancel any older in-progress scatter pass.
	for c in get_children():
		if c is MultiMeshInstance3D:
			c.queue_free()
	call_deferred("_build_field", generation)


func _build_field(generation: int) -> void:
	if not is_inside_tree() or generation != _build_generation:
		return
	_prepare_phase="waiting for terrain"
	# Do not scatter/retry over missing terrain while all four islands cook.
	# Setup explicitly requests the final rebuild when its colliders are ready.
	var setup := get_parent().get_node_or_null("IslandSetup")
	if setup == null: setup = get_parent().get_node_or_null("../IslandSetup")
	while not Engine.is_editor_hint() and setup != null and setup.get("setup_complete") != true:
		await get_tree().process_frame
		if not is_inside_tree() or generation != _build_generation: return
	var active_path := sketchfab_grass_model if not sketchfab_grass_model.is_empty() else grass_mesh_path
	var src := _load_blade_mesh(active_path)
	if src == null:
		push_warning("IslandGrass: no Mesh found at %s (is the model imported?)" % active_path)
		return
	_prepare_phase="sampling"

	var space: PhysicsDirectSpaceState3D = get_world_3d().direct_space_state
	_rng.seed = scatter_seed
	var oc := get_tree().get_first_node_in_group("ocean")
	# World -> this node's local space (the MultiMeshInstance is our child, so
	# its transforms are interpreted in OUR frame, not the world frame).
	var world_to_local := global_transform.affine_inverse()

	# Sample first, then fill. Runtime queries are split over render frames so
	# a field this size cannot monopolize the main thread on mobile.
	var xforms: Array[Transform3D] = []
	var customs: Array[Color] = []
	var target_count := maxi(instance_count, 0)
	var is_mobile := not Engine.is_editor_hint() and GameSettings.mobile_effects_profile()
	# Each of the four islands gets a quarter of the 2 ms grass allowance.
	# Fixed signal order must not let the first field starve later fields.
	var work_lane := StringName("grass_%d"%get_instance_id())
	if is_mobile:
		# Allocate once at the mobile ceiling. Quality changes can then reveal
		# more/fewer tufts without new terrain rays or another loading stall.
		target_count = mini(target_count, 2400)
	if _using_imported_model:
		var tri_count := maxi(floori(float(src.get_faces().size()) / 3.0), 1)
		if tri_count > 24:
			var tri_budget := 75000 if is_mobile else 180000
			target_count = mini(target_count, maxi(floori(float(tri_budget) / float(tri_count)), 64))
	# Four islands scatter concurrently: bound their combined physics work.
	var ray_batch := 16 if is_mobile else RUNTIME_RAY_BATCH_SIZE
	var attempts := target_count * 3
	var misses := 0
	var rays_since_yield := 0
	while xforms.size() < target_count and attempts > 0:
		attempts -= 1
		rays_since_yield += 1
		var a := _rng.randf() * TAU
		var r := sqrt(_rng.randf()) * scatter_radius
		var local := Vector3(cos(a) * r, 0.0, sin(a) * r)
		var from := to_global(local + Vector3(0.0, raycast_up, 0.0))
		var to := to_global(local - Vector3(0.0, raycast_down, 0.0))

		var q := PhysicsRayQueryParameters3D.create(from, to, WORLD_MASK)
		var hit := space.intersect_ray(q)
		if hit.is_empty():
			misses += 1
			# Nothing hit at all after 60 samples: there is no collider yet.
			# Bail early, then retry after another physics frame.
			if misses > 60 and xforms.is_empty():
				break
		else:
			var n: Vector3 = hit["normal"]
			if n.dot(Vector3.UP) >= min_surface_flatness:
				var pos: Vector3 = hit["position"]
				# Grass belongs on the emergent beach: skip the high mound top
				# AND the sand that continues below the water line (the beach
				# scan reaches ~22 m down, so without the lower bound blades
				# would sprout underwater).
				var height_ok := true
				if oc != null:
					var above_water := pos.y - float(oc.call("get_height", pos))
					height_ok = above_water <= max_height_above_water \
							and above_water >= maxf(min_height_above_water, 0.48)
				# Cluster on the inland side; broad bare sand remains at the beach.
				var island_local := (get_parent() as Node3D).to_local(pos)
				var patch := sin(island_local.x * 0.63 + sin(island_local.z * 0.47)) * 0.5 + 0.5
				height_ok = height_ok and patch > 0.24 and island_local.z < scatter_radius * 0.60
				if height_ok:
					var sc := _rng.randf_range(0.8, 1.3)
					var b := Basis()
					if align_to_normal:
						var helper := Vector3.RIGHT if absf(n.dot(Vector3.RIGHT)) < 0.9 else Vector3.FORWARD
						var z := (helper - n * helper.dot(n)).normalized()
						var x := n.cross(z) # right-handed: det = +1
						b = Basis(x, n, z)
						b = b.scaled(Vector3(sc, sc * _rng.randf_range(0.85, 1.25), sc))
						b = b.rotated(n, _rng.randf() * TAU)
					else:
						b = Basis.IDENTITY.scaled(Vector3.ONE * sc)
					# Store the blade in LOCAL space (world hit transformed into our frame).
					xforms.append(world_to_local * Transform3D(b, pos + n * 0.02))
					customs.append(Color(_rng.randf(), _rng.randf(), _rng.randf(), _rng.randf()))

		if not Engine.is_editor_hint() and (FRAME_WORK_BUDGET.exhausted(1,work_lane,16,500) or rays_since_yield >= ray_batch):
			_prepare_progress=Vector2i(target_count*3-attempts,target_count*3)
			rays_since_yield = 0
			await get_tree().process_frame
			if not is_inside_tree() or generation != _build_generation:
				return
			# Refresh the direct-space handle after yielding to the physics loop.
			space = get_world_3d().direct_space_state

	if not is_inside_tree() or generation != _build_generation:
		return
	if xforms.is_empty():
		# The island collider is created after this node's _ready. Retry a
		# bounded number of times; don't spin through the full ray budget.
		if Engine.is_editor_hint():
			push_warning("IslandGrass: no valid ground found — is the island collision generated yet?")
		elif _retries_left > 0:
			_retries_left -= 1
			call_deferred("_retry_rebuild", generation)
		else:
			print("[IslandGrass] gave up: no island collision found")
		return
	_retries_left = RETRY_FRAMES
	_prepare_phase="filling"

	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_custom_data = true # REQUIRED: grass_wind.gdshader reads INSTANCE_CUSTOM
	mm.mesh = src
	mm.instance_count = xforms.size()
	for i in xforms.size():
		mm.set_instance_transform(i, xforms[i])
		mm.set_instance_custom_data(i, customs[i])
		if not Engine.is_editor_hint() and FRAME_WORK_BUDGET.exhausted(1,work_lane,16,500):
			_prepare_progress=Vector2i(i,xforms.size())
			await get_tree().process_frame
			if not is_inside_tree() or generation != _build_generation: return

	var mmi := MultiMeshInstance3D.new()
	mmi.name = "GrassField"
	mmi.multimesh = mm
	mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mmi.extra_cull_margin = 16.0
	mmi.visibility_range_end = 100.0
	mmi.material_override = _make_material()
	mmi.add_to_group("island_grass_field")
	add_child(mmi)
	var performance := get_tree().get_first_node_in_group("mobile_performance")
	if performance != null:
		performance.call("refresh_foliage")
	print("[IslandGrass] placed %d blades" % xforms.size())
	_prepare_phase="ready"
	_prepare_progress=Vector2i(xforms.size(),xforms.size())

## Retry on a later physics frame while waiting for the island collider.
func _retry_rebuild(generation: int) -> void:
	if not is_inside_tree():
		return
	await get_tree().physics_frame
	if is_inside_tree() and generation == _build_generation:
		rebuild()

func _load_blade_mesh(path: String) -> Mesh:
	_imported_albedo_texture = null
	_using_imported_model = false
	if sketchfab_grass_model.is_empty() and natural_tufts and path == "res://models/grass_blade.glb":
		return VEGETATION_VISUAL.grass_tuft()
	var candidates: Array[String] = []
	if not path.is_empty():
		candidates.append(path)
	if not sketchfab_grass_model.is_empty() and not candidates.has("res://3d models/realistic_grass.glb"):
		candidates.append("res://3d models/realistic_grass.glb")
	var found: Mesh = null
	var chosen_path := ""
	for candidate in candidates:
		found = _try_load_mesh_resource(candidate)
		if found != null:
			chosen_path = candidate
			break
	if found == null:
		if natural_tufts:
			return VEGETATION_VISUAL.grass_tuft()
		return null
	var is_custom := (not sketchfab_grass_model.is_empty()) or chosen_path != "res://models/grass_blade.glb"
	if is_custom:
		_using_imported_model = true
		var key := "%s:%.4f" % [found.get_rid().get_id(), target_tuft_height]
		var cached: Mesh = _prepared_meshes.get(key)
		if cached == null:
			cached = _prepare_imported_grass_mesh(found)
			_prepared_meshes[key] = cached
		return cached
	return found

func _try_load_mesh_resource(path: String) -> Mesh:
	if path.is_empty():
		return null
	if path == "res://models/realistic_grass.glb":
		var inst := DEFAULT_GRASS.instantiate()
		var mesh := _find_mesh(inst)
		inst.free()
		return mesh
	if ResourceLoader.exists(path):
		var res: Resource = load(path)
		if res is Mesh:
			_extract_mesh_albedo_texture(res as Mesh)
			return res as Mesh
		if res is PackedScene:
			var inst: Node = (res as PackedScene).instantiate()
			var m := _find_mesh(inst)
			inst.queue_free()
			return m
	if FileAccess.file_exists(path):
		var bytes := FileAccess.get_file_as_bytes(path)
		if not bytes.is_empty():
			var doc := GLTFDocument.new()
			var state := GLTFState.new()
			if doc.append_from_buffer(bytes, path.get_base_dir(), state) == OK:
				var root := doc.generate_scene(state)
				if root != null:
					var m := _find_mesh(root)
					root.free()
					return m
	return null

func _find_mesh(n: Node) -> Mesh:
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
		var mi := n as MeshInstance3D
		for s in range(mi.mesh.get_surface_count()):
			var mat := mi.get_active_material(s)
			if mat is BaseMaterial3D and (mat as BaseMaterial3D).albedo_texture != null:
				_imported_albedo_texture = (mat as BaseMaterial3D).albedo_texture
				break
		if _imported_albedo_texture == null:
			_extract_mesh_albedo_texture(mi.mesh)
		return mi.mesh
	for c in n.get_children():
		var m := _find_mesh(c)
		if m != null:
			return m
	return null

func _extract_mesh_albedo_texture(mesh: Mesh) -> void:
	if mesh == null:
		return
	for s in range(mesh.get_surface_count()):
		var mat := mesh.surface_get_material(s)
		if mat is BaseMaterial3D and (mat as BaseMaterial3D).albedo_texture != null:
			_imported_albedo_texture = (mat as BaseMaterial3D).albedo_texture
			return

## Normalizes an external Sketchfab/GLB grass clump so its roots sit at y=0,
## its height matches target_tuft_height, and COLOR_0 carries a 0..1 vertical
## wind mask even when the source model lacks vertex-painted wind weights.
func _prepare_imported_grass_mesh(src: Mesh) -> Mesh:
	var aabb := src.get_aabb()
	if aabb.size.y <= 0.0001 or src.get_surface_count() == 0:
		return src
	var desired_h := maxf(target_tuft_height, 0.1)
	var scale_factor := desired_h / aabb.size.y
	var center_x := aabb.position.x + aabb.size.x * 0.5
	var center_z := aabb.position.z + aabb.size.z * 0.5
	var min_y := aabb.position.y
	var inv_h := 1.0 / aabb.size.y

	var out := ArrayMesh.new()
	for s in range(src.get_surface_count()):
		var arrays := src.surface_get_arrays(s)
		if arrays.is_empty():
			continue
		var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		if verts.is_empty():
			continue
		var colors: PackedColorArray = arrays[Mesh.ARRAY_COLOR] if arrays[Mesh.ARRAY_COLOR] != null else PackedColorArray()
		var has_gradient := false
		if colors.size() == verts.size():
			var c_min := 1.0
			var c_max := 0.0
			for c in colors:
				c_min = minf(c_min, c.r)
				c_max = maxf(c_max, c.r)
			has_gradient = (c_max - c_min) > 0.25
		if not has_gradient:
			colors.resize(verts.size())
		for i in range(verts.size()):
			var v := verts[i]
			var h := clampf((v.y - min_y) * inv_h, 0.0, 1.0)
			verts[i] = Vector3(
				(v.x - center_x) * scale_factor,
				(v.y - min_y) * scale_factor,
				(v.z - center_z) * scale_factor
			)
			if not has_gradient:
				colors[i] = Color(h, h, h, 1.0)
		arrays[Mesh.ARRAY_VERTEX] = verts
		arrays[Mesh.ARRAY_COLOR] = colors
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return out if out.get_surface_count() > 0 else src

func _make_material() -> ShaderMaterial:
	var mat := ShaderMaterial.new()
	if not shader_path.is_empty() and ResourceLoader.exists(shader_path):
		mat.shader = load(shader_path)
		if _imported_albedo_texture != null:
			mat.set_shader_parameter("use_albedo_texture", true)
			mat.set_shader_parameter("albedo_texture", _imported_albedo_texture)
	return mat
