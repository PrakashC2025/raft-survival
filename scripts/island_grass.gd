@tool
extends Node3D
## Island grass scatterer (Part 9 of the island guide).
## Raycasts down at random points around itself and, wherever it hits
## flat-enough ground, places one REALISTIC GRASS CLUMP into a single
## MultiMeshInstance3D (one draw call for every clump — mobile friendly).
##
## Source mesh: grass/baked/scan_tuft.tres — a scanned grass tuft from
## models/scanned_plants_and_grass_free_download.glb, baked once by
## tools/bake_island_vegetation.gd (base at y = 0, ~73 tris — thousands of
## instances stay smooth even on mobile).
## grass_wind.gdshader derives its sway mask from the local height and
## reads the albedo texture baked next to the mesh.

const WORLD_MASK := 1
## Static access to the island height field + noise for the grass-line mask.
const IslandGen := preload("res://scripts/island_generator.gd")
## Device tiering + the runtime FPS governor (statics; safe via preload).
const MobilePerf := preload("res://scripts/mobile_perf.gd")
## Baked field: saved after a successful runtime rebuild, then reused by both
## the editor and the game so both show the exact same grass placement.
## Delete res://grass/island_grass_baked.tres to force a re-bake.
const BAKED_PATH := "res://grass/island_grass_baked.tres"
## Runtime retry budget: the terrain collider is generated by
## island_generator.gd around this node's _ready (tree order), so the first
## pass can find no ground. Retry a few frames until the collider exists.
const RETRY_FRAMES := 30

@export_file("*.res", "*.tres", "*.glb") var grass_mesh_path := "res://grass/baked/grass_clump.res": set = set_grass_mesh_path
@export_file("*.png") var albedo_texture_path := "res://grass/baked/grass_clump_albedo.png": set = set_albedo_texture_path
@export_file("*.gdshader") var shader_path := "res://shaders/grass_wind.gdshader": set = set_shader_path
@export var instance_count := 9000: set = set_instance_count ## the REAL ~1 m grass clump (2697 tris) reads as a full meadow at ~9k; the old tiny tuft needed 15000
@export var scatter_radius := 10.0: set = set_scatter_radius
@export var scatter_seed := 12345: set = set_seed
@export var raycast_up := 8.0 ## how far above the node to start searching
@export var raycast_down := 12.0 ## how far below the node to search
@export var min_surface_flatness := 0.55 ## 1.0 = perfectly flat, 0.55 = every slope the terrain paint considers grassy (plus a spillover band)
@export var align_to_normal := true
@export var max_height_above_water := 14.0 ## above the island summit (~13.6 m): the WHOLE mountain is eligible, not just its lower slopes
@export var cast_shadows := true ## grass casts directional shadows (alpha-cut holes are honored); auto-off on mobile
@export var visibility_distance := 120.0 ## fade the field out over the last 12 m up to this range (0 = always visible)

var _rng := RandomNumberGenerator.new()
var _retries_left := RETRY_FRAMES
# ---- runtime governor state (MobilePerf FPS governor, mobile only) ----
var _gov_vis := 1.0
var _gov_count := 1.0
var _bake_xforms := PackedVector3Array() # full bake, for governor re-writes
var _bake_customs := PackedColorArray()
var _full_count := 0 # clumps actually placed (post tier-cap)

func _ready() -> void:
	# The MobilePerf governor steers this field while playing (visibility
	# range + instance count on weak devices).
	add_to_group("grass_field")
	if Engine.is_editor_hint():
		# Editor: show the baked field (no raycast colliders exist here).
		_load_baked()
		return
	if _load_baked():
		return
	rebuild()

# ---- editor live-rebuild on any tweak ----
func set_grass_mesh_path(v: String) -> void:
	grass_mesh_path = v
	_rebuild_if_ready()

func set_albedo_texture_path(v: String) -> void:
	albedo_texture_path = v
	_rebuild_if_ready()

func set_shader_path(v: String) -> void:
	shader_path = v
	_rebuild_if_ready()

func set_instance_count(v: int) -> void:
	instance_count = v
	_rebuild_if_ready()

func set_scatter_radius(v: float) -> void:
	scatter_radius = v
	_rebuild_if_ready()

func set_seed(v: int) -> void:
	scatter_seed = v
	_rebuild_if_ready()

func _rebuild_if_ready() -> void:
	if not is_inside_tree():
		return
	if Engine.is_editor_hint():
		_load_baked()
		return
	rebuild()

func _notification(what: int) -> void:
	if what == NOTIFICATION_TRANSFORM_CHANGED and Engine.is_editor_hint():
		_load_baked()

func rebuild() -> void:
	# Drop previous field
	for c in get_children():
		if c is MultiMeshInstance3D:
			c.queue_free()

	var src := _load_blade_mesh(grass_mesh_path)
	if src == null:
		push_warning("IslandGrass: no Mesh found at %s (run tools/bake_island_vegetation.gd)" % grass_mesh_path)
		return
	# Tier-based density: the fallback scatter path (bake missing) targets
	# the same clump budget the baked field is capped to.
	var target := instance_count
	if MobilePerf.mobile_like():
		target = maxi(mini(instance_count, MobilePerf.grass_clumps()), 200)

	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_custom_data = true   # REQUIRED: grass_wind.gdshader reads INSTANCE_CUSTOM
	mm.mesh = src
	mm.instance_count = target

	var space := get_world_3d().direct_space_state
	_rng.seed = scatter_seed

	var oc := get_tree().get_first_node_in_group("ocean") if is_inside_tree() else null
	# World -> this node's local space (the MultiMeshInstance is our child, so
	# its transforms are interpreted in OUR frame, not the world frame).
	var world_to_local := global_transform.affine_inverse()

	# Sample first, then fill: collect up to instance_count valid placements
	# with a global attempt budget (retries are shared, never per-blade spinning).
	# target*4: the wide radius + relaxed mask reject more samples, so the
	# budget must scale with the rejection rate or the field under-fills.
	var xforms: Array[Transform3D] = []
	var customs: Array[Color] = []
	var attempts := target * 4
	var misses := 0
	while xforms.size() < target and attempts > 0:
		attempts -= 1
		var a := _rng.randf() * TAU
		var r := sqrt(_rng.randf()) * scatter_radius
		var local := Vector3(cos(a) * r, 0.0, sin(a) * r)
		var from := to_global(local + Vector3(0.0, raycast_up, 0.0))
		var to := to_global(local - Vector3(0.0, raycast_down, 0.0))

		# Plain world ray: hits on props (rocks/palms) are rejected further
		# below by the flatness check, the analytic height-field check
		# ("hit stands above the ground") and the grass-line mask, so clumps
		# never grow out of a boulder or dangle off a cliff.
		var q := PhysicsRayQueryParameters3D.create(from, to, WORLD_MASK)
		var hit := space.intersect_ray(q)
		if hit.is_empty():
			misses += 1
			# Nothing hit at all after 60 samples: there is no collider yet
			# (island_generator.gd may still be building it). Bail out early
			# instead of burning the whole attempt budget every retry frame.
			if misses > 60 and xforms.is_empty():
				break
			continue
		var n: Vector3 = hit["normal"]
		if n.dot(Vector3.UP) < min_surface_flatness:
			continue # too steep
		var pos: Vector3 = hit["position"]
		# Reject hits that are NOT the terrain: compare against the analytic
		# height field — rocks/palms stick up well above it (their top is
		# higher than terrain_height at that XZ), grass-on-rock vanishes.
		var island: Node3D = null
		if is_inside_tree():
			island = get_tree().get_first_node_in_group("island") as Node3D
		if island != null:
			var rq := Vector2(pos.x, pos.z) - Vector2(island.global_position.x, island.global_position.z)
			if pos.y > IslandGen.terrain_height_local(rq) + 0.35:
				continue # hit something standing on the ground, not the ground
		# Grass belongs on the lower slopes: reject points high above sea level
		if oc != null and pos.y - float(oc.call("get_height", pos)) > max_height_above_water:
			continue
		# GRASS-LINE MASK — mirror the terrain paint rule from
		# island_generator._build_terrain() so clumps grow ONLY where the
		# ground is actually painted grass (never on the sand beach, the
		# bare mountain scree, or cliff faces). Reuses `island` from above.
		if island != null:
			var gq := Vector2(pos.x, pos.z) - Vector2(island.global_position.x, island.global_position.z)
			var th: float = IslandGen.terrain_height_local(gq)
			var jit: float = IslandGen.fbm_public(gq * 0.22 + Vector2(51.2, 17.3))
			var sand_h := 2.2 + (jit - 0.5) * 2.0
			var jit2: float = IslandGen.fbm_public(gq * 0.9 + Vector2(11.7, 63.1))
			var gk_raw := smoothstep(sand_h, sand_h + 2.2, th) * smoothstep(0.62, 0.86, n.dot(Vector3.UP))
			var gk := smoothstep(0.3, 0.7, gk_raw + (jit2 - 0.5) * 0.5)
			# 0.22 (was 0.35): the big real clumps may reach almost to the
			# waterline — sparse fringe grass on the upper beach reads as a
			# natural transition, and the field covers the whole island.
			# Below ~0.22 the ground is painted pure sand, so the mask still
			# keeps the actual beach clear.
			if gk < 0.22:
				continue

		# The real ~1 m clump: 0.85-1.6 gives natural size variety at full
		# meadow scale (the old 1.4-2.6 was sized for the tiny 0.35 m tuft —
		# applied to this mesh it made 2.6 m monster bushes).
		var sc := _rng.randf_range(0.85, 1.6)
		var b := Basis()
		if align_to_normal:
			var helper := Vector3.RIGHT if absf(n.dot(Vector3.RIGHT)) < 0.9 else Vector3.FORWARD
			var z := (helper - n * helper.dot(n)).normalized()
			var x := n.cross(z) # right-handed: det = +1
			b = Basis(x, n, z)
			# Grass stretches UP toward light: height 0.9-1.35x the footprint
			# keeps clumps tufty instead of flat pancake patches.
			b = b.scaled(Vector3(sc, sc * _rng.randf_range(0.9, 1.35), sc))
			b = b.rotated(n, _rng.randf() * TAU)
		else:
			b = Basis.IDENTITY.scaled(Vector3.ONE * sc)
		# SEAT THE TUFT: sink the base ~40% of clump-height into the ground so
		# the ray hit sits INSIDE the tuft — on curved/sloped ground (the whole
		# mountain) shallower seating leaves the downhill edge visibly floating.
		xforms.append(world_to_local * Transform3D(b, pos - n * sc * 0.16))
		# INSTANCE_CUSTOM: x = wind phase, y = strength, z = tint variation
		customs.append(Color(_rng.randf(), _rng.randf(), _rng.randf(), 1.0))

	if xforms.is_empty():
		# Expected on the very first (editor-order) _ready pass at runtime;
		# the terrain collider is generated a moment later by island_generator.gd.
		if Engine.is_editor_hint():
			push_warning("IslandGrass: no valid ground found — is the island collision generated yet?")
		elif _retries_left > 0:
			_retries_left -= 1
			_retry_rebuild.call_deferred()
		else:
			print("[IslandGrass] gave up: no island collision found")
		return
	_retries_left = RETRY_FRAMES

	mm.instance_count = xforms.size()
	for i in xforms.size():
		mm.set_instance_transform(i, xforms[i])
		mm.set_instance_custom_data(i, customs[i])
	# Bake: persist the field so the editor and future runs reuse it 1:1.
	# (Plain arrays — ResourceSaver does not serialize MultiMesh instance data.)
	# Also saved from headless runs: tools/bake_grass_field.gd regenerates the
	# shipped field after any placement-rule change.
	if OS.has_feature("editor") or DisplayServer.get_name() == "headless":
		var xf := PackedVector3Array()
		var cd := PackedColorArray()
		for t in xforms:
			xf.append(t.basis.x)
			xf.append(t.basis.y)
			xf.append(t.basis.z)
			xf.append(t.origin)
		for c in customs:
			cd.append(c)
		var bake := Resource.new()
		bake.set_meta("xforms", xf)
		bake.set_meta("customs", cd)
		if ResourceSaver.save(bake, BAKED_PATH) != OK:
			push_warning("IslandGrass: could not save baked grass field")

	var mmi := MultiMeshInstance3D.new()
	mmi.name = "GrassField"
	mmi.multimesh = mm
	_apply_quality(mmi)
	var mat := _make_material()
	if mat != null:
		mmi.material_override = mat
	add_child(mmi)
	print("[IslandGrass] placed %d clumps" % xforms.size())

## One-frame-later retry (runtime only) while waiting for the island collider.
func _retry_rebuild() -> void:
	if not is_inside_tree():
		return
	# Physics frames, not process frames: the terrain collider generated by
	# island_generator.gd only becomes raycastable after a physics step.
	await get_tree().physics_frame
	if is_inside_tree():
		rebuild()

func _load_blade_mesh(path: String) -> Mesh:
	if path.is_empty() or not ResourceLoader.exists(path):
		return null
	var res: Resource = load(path)
	if res is Mesh:
		return res
	# glb scenes: dig out the first MeshInstance3D's mesh
	if res is PackedScene:
		var inst: Node = (res as PackedScene).instantiate()
		var found := _find_mesh(inst)
		inst.queue_free()
		return found
	return null

func _find_mesh(n: Node) -> Mesh:
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
		return (n as MeshInstance3D).mesh
	for c in n.get_children():
		var m := _find_mesh(c)
		if m != null:
			return m
	return null

func _make_material() -> ShaderMaterial:
	# No shader -> return null so the MultiMesh keeps the mesh's own baked-in
	# material (an empty ShaderMaterial override would render solid pink).
	if shader_path.is_empty() or not ResourceLoader.exists(shader_path):
		return null
	var mat := ShaderMaterial.new()
	mat.shader = load(shader_path)
	if not albedo_texture_path.is_empty() and ResourceLoader.exists(albedo_texture_path):
		mat.set_shader_parameter("albedo_tex", load(albedo_texture_path))
	# Keep in sync with the shader default: low threshold so minified mip
	# alpha (VRAM-compressed atlas) never triggers the scissor distance-fade
	# that erased the whole field at gameplay distance.
	mat.set_shader_parameter("alpha_cut", 0.26)
	return mat

## Load the baked grass field (identical placement in editor and game).
func _load_baked() -> bool:
	if not ResourceLoader.exists(BAKED_PATH):
		return false
	var bake := load(BAKED_PATH) as Resource
	if bake == null or not bake.has_meta("xforms"):
		return false
	var xf: PackedVector3Array = bake.get_meta("xforms")
	var cd: PackedColorArray = bake.get_meta("customs")
	var count := int(xf.size() / 4.0)
	if count == 0:
		return false
	# Mobile: keep a LUSH field — heavy thinning reads bald on the big
	# green mountain (user report). Tier cap (low 5000 / mid 6000 / high
	# 7000) still holds ONE draw call; behind-camera/occluded instances
	# cost almost nothing. The runtime governor may thin further on a
	# struggling device (see governor_quality).
	var cap := MobilePerf.grass_clumps()
	if count > cap:
		count = cap
	var src := _load_blade_mesh(grass_mesh_path)
	if src == null:
		return false
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_custom_data = true
	mm.mesh = src
	mm.instance_count = count
	for i in count:
		var b := Basis(xf[i * 4], xf[i * 4 + 1], xf[i * 4 + 2])
		mm.set_instance_transform(i, Transform3D(b, xf[i * 4 + 3]))
		mm.set_instance_custom_data(i, cd[i])
	# Keep the full arrays for the runtime governor (it re-writes instance
	# data when a struggling device needs the field thinned).
	_bake_xforms = xf
	_bake_customs = cd
	_full_count = count
	for c in get_children():
		if c is MultiMeshInstance3D:
			c.queue_free()
	var mmi := MultiMeshInstance3D.new()
	mmi.name = "GrassField"
	mmi.multimesh = mm
	_apply_quality(mmi)
	var mat := _make_material()
	if mat != null:
		mmi.material_override = mat
	add_child(mmi)
	print("[IslandGrass] loaded baked field (%d clumps)" % count)
	return true

## Per-field render quality: shadows (alpha scissor holes are honored in
## the shadow pass, so blades cast dappled shade), extra cull margin and a
## soft distance fade so the field never pops when the island comes into
## view from the raft. Shadows are force-disabled on mobile builds where
## every shadow-caster counts; the distance fade is engine-side culling
## and stays on everywhere.
func _apply_quality(mmi: MultiMeshInstance3D) -> void:
	var shadows := cast_shadows and not OS.has_feature("mobile")
	mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if shadows \
		else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mmi.extra_cull_margin = 16.0
	if visibility_distance > 0.0:
		mmi.visibility_range_end = visibility_distance * _gov_vis
		mmi.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF

## Called by the MobilePerf FPS governor (group "grass_field") when a device
## runs below the 60 fps budget while playing. vis_mul scales the field's
## draw distance, count_mul thins the field (first N clumps of the bake —
## scatter order is random, so thinning stays spatially uniform). Restoring
## re-writes everything back from the retained full bake. Desktop never
## calls this.
func governor_quality(vis_mul: float, count_mul: float) -> void:
	_gov_vis = vis_mul
	_gov_count = count_mul
	_apply_governor()

func _apply_governor() -> void:
	var mmi := _grass_mmi()
	if mmi == null:
		return
	if visibility_distance > 0.0:
		mmi.visibility_range_end = visibility_distance * _gov_vis
	if _bake_xforms.is_empty():
		return # scatter path: no retained full bake, count stays as built
	var target := clampi(int(float(_full_count) * _gov_count), 500, _full_count)
	var mm := mmi.multimesh as MultiMesh
	if mm == null or target == mm.instance_count:
		return
	mm.instance_count = target
	for i in target:
		var b := Basis(_bake_xforms[i * 4], _bake_xforms[i * 4 + 1], _bake_xforms[i * 4 + 2])
		mm.set_instance_transform(i, Transform3D(b, _bake_xforms[i * 4 + 3]))
		mm.set_instance_custom_data(i, _bake_customs[i])
	print("[IslandGrass] governor: visibility %.0f m, %d clumps" % [visibility_distance * _gov_vis, target])

func _grass_mmi() -> MultiMeshInstance3D:
	for c in get_children():
		if c is MultiMeshInstance3D and c.name == "GrassField":
			return c
	return null
